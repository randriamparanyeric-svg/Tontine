@{
    ViewData["Title"] = "Bienvenue - Tontine Smart";
}

<div class="container mt-5">
    <!-- BANNIÈRE D'ACCUEIL -->
    <div class="row align-items-center py-5 rounded-4 shadow-sm bg-gradient-light text-center text-md-start" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
        <div class="col-md-7 ps-lg-5">
            <h1 class="display-3 fw-bold text-primary">🎯 Tontine <span class="text-success">Smart</span></h1>
            <p class="lead text-dark fw-semibold">L'évolution numérique de l'épargne solidaire.</p>
            <p class="text-muted">Gérez facilement vos groupes, sécurisez vos fonds et suivez vos gains en un clic.</p>
            
            <!-- BOUTONS CENTRÉS SUR MOBILE ET FLUIDES -->
            <div class="mt-4 d-flex flex-wrap justify-content-center justify-content-md-start gap-3">
                <a asp-controller="Groupes" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow-sm btn-hover-effect">
                    <i class="bi bi-list-task me-2"></i>Mes Tontines
                </a>
                <a asp-controller="Groupes" asp-action="Create" class="btn btn-success btn-lg px-4 shadow-sm btn-hover-effect">
                    <i class="bi bi-plus-circle me-2"></i>Créer un groupe
                </a>
                <!-- BOUTON WHATSAPP -->
                <a href="https://wa.me/261326457208?text=Bonjour,%20je%20souhaite%20avoir%20plus%20d'informations%20sur%20Tontine%20Smart" 
                   target="_blank" 
                   class="btn btn-lg px-4 shadow-sm btn-hover-effect border-0 text-white" 
                   style="background-color: #25D366;">
                    <i class="bi bi-whatsapp me-2"></i>WhatsApp
                </a>
                <!-- NOUVEAU BOUTON : APPELER LE RESPONSABLE -->
                <a href="tel:+261346447461" 
                   class="btn btn-dark btn-lg px-4 shadow-sm btn-hover-effect">
                    <i class="bi bi-telephone-fill me-2 text-warning"></i>Appeler le responsable
                </a>
            </div>
        </div>
        <div class="col-md-5 text-center d-none d-md-block">
            <div class="display-1 filter-drop-shadow">💰</div>
            <div class="badge bg-white text-primary border p-3 mt-3 shadow-sm rounded-pill">
                <i class="bi bi-shield-check me-2"></i> 100% Digitalisé
            </div>
        </div>
    </div>

    <!-- SECTION : HISTOIRE DE NOTRE SOLIDARITÉ -->
    <div class="row mt-5 pt-4">
        <div class="col-12 text-center mb-5">
            <h2 class="fw-bold">L'histoire de notre solidarité</h2>
            <div class="mx-auto bg-primary rounded" style="height: 4px; width: 60px;"></div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="p-4 border-start border-4 border-warning bg-light h-100 rounded-3 shadow-sm">
                <h4 class="text-warning fw-bold"><i class="bi bi-hourglass-split me-2"></i>La Tontine d'Autrefois</h4>
                <p class="text-muted mb-0">Depuis des générations, nos ancêtres utilisaient la tontine basée uniquement sur la parole et la confiance physique. C'était un pilier de l'économie locale, mais avec des risques de pertes, de manque de suivi et de désaccords sur les dates.</p>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="p-4 border-start border-4 border-success bg-light h-100 rounded-3 shadow-sm">
                <h4 class="text-success fw-bold"><i class="bi bi-cpu me-2"></i>La Tontine Nouvelle (Smart)</h4>
                <p class="text-muted mb-0">Aujourd'hui, <strong>Tontine Smart</strong> conserve l'esprit de solidarité tout en éliminant les doutes. Grâce à la technologie, chaque versement est enregistré, chaque membre est notifié, et la transparence est totale pour tous les participants.</p>
            </div>
        </div>
    </div>

    <!-- SECTION : GUIDE D'UTILISATION DÉTAILLÉ PAS À PAS -->
    <div class="row mt-5 pt-4">
        <div class="col-12 text-center mb-5">
            <h2 class="fw-bold text-primary"><i class="bi bi-book me-2"></i>Guide d'utilisation pas à pas</h2>
            <div class="mx-auto bg-primary rounded" style="height: 4px; width: 80px;"></div>
            <p class="text-muted mt-2">Découvrez comment fonctionne votre plateforme Tontine Smart de A à Z.</p>
        </div>

        <!-- Étape 1 : Création du groupe par l'admin -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-primary rounded-circle me-3 fs-5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">1</span>
                        <h5 class="fw-bold mb-0">Création du Groupe par l'Admin</h5>
                    </div>
                    <p class="text-muted small mb-0">
                        L'administrateur crée et gère le groupe en définissant le nom de la tontine et le montant de la cotisation. Lors de cette création, <strong>l'administrateur devient automatiquement le premier membre</strong> du groupe.
                    </p>
                </div>
            </div>
        </div>

        <!-- Étape 2 : Demande et Attente d'activation -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-warning text-dark rounded-circle me-3 fs-5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">2</span>
                        <h5 class="fw-bold mb-0">Attente d'Activation & Essai</h5>
                    </div>
                    <p class="text-muted small mb-0">
                        Après le lancement de la demande, l'espace passe en statut <em>"En attente d'activation"</em>. Vous bénéficiez d'une <strong>période d'essai gratuite d'un mois</strong> avant validation complète par l'équipe technique.
                    </p>
                </div>
            </div>
        </div>

        <!-- Étape 3 : Espace Trésorier & Mot de passe -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-success rounded-circle me-3 fs-5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">3</span>
                        <h5 class="fw-bold mb-0">Espace Trésorier Sécurisé</h5>
                    </div>
                    <p class="text-muted small mb-0">
                        L'accès au panneau d'administration nécessite un <strong>mot de passe sécurisé</strong>. Seul l'administrateur possède le privilège exclusif d'<strong>ajouter de nouveaux membres</strong> dans la tontine.
                    </p>
                </div>
            </div>
        </div>

        <!-- Étape 4 : Consultation "Voir comme membre" -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-info text-white rounded-circle me-3 fs-5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">4</span>
                        <h5 class="fw-bold mb-0">Espace Membre par Numéro</h5>
                    </div>
                    <p class="text-muted small mb-0">
                        Chaque membre accède à son espace personnel <strong>"Voir comme Membre"</strong> en saisissant son numéro de téléphone. L'administrateur peut également y accéder via son propre numéro.
                    </p>
                </div>
            </div>
        </div>

        <!-- Étape 5 : Photos CIN (Recto / Verso) -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-secondary rounded-circle me-3 fs-5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">5</span>
                        <h5 class="fw-bold mb-0">Vérification CIN (Recto & Verso)</h5>
                    </div>
                    <p class="text-muted small mb-0">
                        Afin de garantir une sécurité maximale et une confiance mutuelle, une zone dédiée est intégrée dans l'espace membre pour téléverser les <strong>photos de la Carte d'Identité Nationale</strong>.
                    </p>
                </div>
            </div>
        </div>

        <!-- Étape 6 : Durée dynamique & Validation des opérations -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 p-3 bg-light">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-dark rounded-circle me-3 fs-5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">6</span>
                        <h5 class="fw-bold mb-0">Durée Flexible & Flux Validés</h5>
                    </div>
                    <p class="text-muted small mb-0">
                        La durée totale varie selon le nombre de participants. De plus, chaque <strong>versement et demande de retrait</strong> reste en attente jusqu'à la <strong>validation officielle de l'administrateur</strong>.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5">

    <!-- AVANTAGES CLÉS -->
    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-hover h-100 transition">
                <div class="card-body py-5">
                    <div class="display-4 text-primary mb-3">🔐</div>
                    <h5 class="fw-bold">Sécurisé</h5>
                    <p class="card-text text-muted mb-0">Accès restreint par mot de passe et cryptage des données sensibles.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-hover h-100 transition">
                <div class="card-body py-5">
                    <div class="display-4 text-success mb-3">👥</div>
                    <h5 class="fw-bold">Collaboratif</h5>
                    <p class="card-text text-muted mb-0">Gestion simplifiée des membres et des invitations au sein de votre cercle.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-hover h-100 transition">
                <div class="card-body py-5">
                    <div class="display-4 text-info mb-3">📊</div>
                    <h5 class="fw-bold">Transparent</h5>
                    <p class="card-text text-muted mb-0">Historique complet des versements disponible 24h/24 pour tous.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CONDITIONS ET PRÉLÈVEMENT -->
    <div class="row mt-5 mb-5">
        <div class="col-12">
            <div class="alert alert-info border-0 shadow-sm p-4">
                <h4 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-info-square-fill me-2"></i>Fepetra momba ny fampiasana (Conditions)</h4>
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <p class="mb-1"><strong>Amin'ny fampiasana ity sehatra ity, ny mpikambana rehetra dia manaiky ireto fepetra manaraka ireto :</strong></p>
                        <p class="fs-5 text-dark mb-2">
                            Ny mpikambana tsirairay dia tsy maintsy mandoa ny <strong>15%</strong> amin'ny vola azony (gain) ho an'ny fitantanana ny tontine.
                        </p>
                        <small class="text-muted italic">Ce prélèvement de 15% assure la maintenance et la pérennité de votre plateforme Tontine Smart.</small>
                    </div>
                    <div class="col-md-4 text-center mt-3 mt-md-0">
                        <div class="h2 fw-bold text-primary mb-0">15%</div>
                        <div class="small fw-bold text-uppercase mb-3">Latsakemboka</div>
                        <a href="https://wa.me/261326457208?text=Bonjour,%20je%20souhaite%20avoir%20plus%20d'informations%20sur%20les%20conditions%20Tontine%20Smart" 
                           target="_blank" 
                           class="btn btn-success btn-sm px-3 shadow-sm rounded-pill fw-bold btn-hover-effect">
                            <i class="bi bi-whatsapp me-1"></i> Plus d'informations
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Effets de mouvement fluides pour les boutons */
    .btn-hover-effect {
        transition: all 0.3s ease-in-out;
        position: relative;
    }

    .btn-hover-effect:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15) !important;
    }

    .btn-hover-effect:active {
        transform: translateY(-1px) scale(0.98);
    }

    /* Effets d'ombre et de survol sur les cartes */
    .shadow-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .shadow-hover:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .bg-gradient-light {
        border: 1px solid rgba(0,0,0,0.05);
    }

    .filter-drop-shadow {
        filter: drop-shadow(0 10px 10px rgba(0,0,0,0.1));
    }
</style>