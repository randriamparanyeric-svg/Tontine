@model Tontine.Models.Groupe

@{
    ViewData["Title"] = "Activation de votre Tontine";
}

<div class="container mt-5 mb-5 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="progress rounded-0" style="height: 6px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" style="width: 75%"></div>
                </div>

                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="display-1 text-warning pulse-animation">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>

                    <h2 class="fw-bold text-dark mb-3">Presque terminé !</h2>
                    <p class="text-muted fs-5">
                        Félicitations, votre tontine <span class="text-primary fw-bold">"@Model.Nom"</span> a été enregistrée avec succès.
                    </p>

                    <hr class="my-4 opacity-25">

                    <div class="alert alert-warning border-0 shadow-sm rounded-3 py-3">
                        <h5 class="alert-heading fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Statut : En attente d'activation</h5>
                        <p class="mb-0 small">
                            Pour garantir la sécurité de vos données et le support technique de votre registre, 
                            votre espace doit être validé manuellement par notre équipe technique.
                        </p>
                    </div>

                    <div class="mt-5 text-start">
                        <h6 class="fw-bold text-dark text-center mb-4 text-uppercase letter-spacing-1">
                            <i class="bi bi-patch-check text-primary"></i> Comment activer votre espace ?
                        </h6>
                        
                        <div class="row g-3">
                            <!-- ÉTAPE 1 : PÉRIODE D'ESSAI -->
                            <div class="col-12">
                                <div class="d-flex align-items-center p-3 bg-light rounded-3 border-start border-primary border-4">
                                    <span class="badge bg-primary rounded-circle me-3 flex-shrink-0">1</span>
                                    <span>Profitez de votre <strong>1 mois d'essai gratuit</strong>. Passé ce délai, les frais de service seront de <strong>20 000 Ar</strong> pour continuer à utiliser la plateforme.</span>
                                </div>
                            </div>
                            
                            <!-- ÉTAPE 2 : LIENS DE CONTACT AVEC LE NOM DE LA TONTINE DANS WHATSAPP -->
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border-start border-primary border-4">
                                    <div class="d-flex align-items-start mb-3">
                                        <span class="badge bg-primary rounded-circle me-3 flex-shrink-0">2</span>
                                        <span>Transmettez votre référence ou contactez le support pour toute information :</span>
                                    </div>
                                    
                                    <div class="bg-white p-3 rounded-3 shadow-sm border text-center mx-md-4">
                                        <div class="mb-2">
                                            <a href="https://wa.me/261326457208?text=@Uri.EscapeDataString("Bonjour, je souhaite avoir plus d'informations concernant l'activation de ma tontine intitulée : " + Model.Nom)" target="_blank" class="text-decoration-none text-success fw-bold d-block">
                                            <i class="bi bi-whatsapp text-success"></i> +261 32 64 572 08 (WhatsApp)
                                            </a>
                                        </div>
                                        <div class="mb-2 small">
                                            <i class="bi bi-facebook text-primary"></i> <span class="fw-semibold">Eric Gr</span> (Facebook)
                                        </div>
                                        <div class="text-dark fw-bold small border-top pt-2 mt-2">
                                            <i class="bi bi-phone-vibrate text-danger"></i> +261 34 64 474 61
                                            <br><span class="text-muted fw-normal">(M-Vola : Makalahiarison)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="d-flex align-items-center p-3 bg-light rounded-3 border-start border-primary border-4">
                                    <span class="badge bg-primary rounded-circle me-3 flex-shrink-0">3</span>
                                    <span>Votre accès sera débloqué rapidement après vérification par notre équipe.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 d-flex flex-column flex-md-row gap-3 justify-content-center">
                        <a asp-action="Index" class="btn btn-light border btn-lg px-4 btn-animate">
                            <i class="bi bi-house-door"></i> Accueil
                        </a>
                        <button onclick="window.location.reload();" class="btn btn-primary btn-lg px-4 shadow btn-animate">
                            <i class="bi bi-arrow-clockwise"></i> Vérifier l'activation
                        </button>
                    </div>
                </div>

                <div class="card-footer bg-dark text-white text-center py-3 border-0">
                    <span class="opacity-75 small">ID de votre tontine :</span> 
                    <span class="badge bg-light text-dark ms-1">#@Model.Id</span>
                    <div class="small mt-1 opacity-50">(À mentionner lors de votre message)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .letter-spacing-1 { letter-spacing: 1px; }
    
    .pulse-animation {
        animation: pulse-yellow 2s infinite;
    }

    @@keyframes pulse-yellow {
        0% { transform: scale(0.95); opacity: 0.8; }
        70% { transform: scale(1); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.8; }
    }

    .btn-animate {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .btn-animate:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.1) !important;
    }

    .card {
        background: #ffffff;
    }

    .badge.rounded-circle {
        width: 25px;
        height: 25px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }
</style>