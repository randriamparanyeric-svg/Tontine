@model Tontine.Models.Groupe

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <!-- Carte Principale -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- En-tête de la carte -->
                <div class="card-header bg-gradient-primary text-white p-4 text-center border-0">
                    <h2 class="fw-bold mb-1 display-6">🎯 @Model.Nom</h2>
                    <p class="text-white-50 mb-0 small">Tableau de bord de la tontine</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4 p-3 bg-light rounded-3 border-start border-4 border-primary">
                            <p class="text-secondary mb-0">@Model.Description</p>
                        </div>
                    }

                    <!-- Statistiques (Montant et Membres) -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm bg-primary bg-gradient text-white h-100 rounded-3">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-wallet2 fs-4 me-2 opacity-75"></i>
                                        <h6 class="text-uppercase tracking-wider opacity-75 small fw-bold mb-0">Montant par Versement</h6>
                                    </div>
                                    <h3 class="mb-0 fw-bold">@Model.MontantParVersement.ToString("N0").Replace(",", " ") <small class="fs-6 fw-normal">Ar</small></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm bg-success bg-gradient text-white h-100 rounded-3">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-people-fill fs-4 me-2 opacity-75"></i>
                                        <h6 class="text-uppercase tracking-wider opacity-75 small fw-bold mb-0">Participants</h6>
                                    </div>
                                    <h3 class="mb-0 fw-bold">@Model.Membres.Count <small class="fs-6 fw-normal">inscrit(s)</small></h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions Principales -->
                    <div class="d-grid gap-3 pt-2">
                        <button type="button" class="btn btn-success btn-lg py-3 shadow-sm btn-hover-effect fw-semibold" data-bs-toggle="modal" data-bs-target="#adminModal">
                            <i class="bi bi-shield-lock-fill me-2"></i> Espace Trésorier / Admin
                        </button>
                        <a asp-action="IdentifierMembre" asp-route-codePartage="@Model.CodePartage" class="btn btn-outline-info btn-lg py-3 shadow-sm btn-hover-effect fw-semibold text-dark border-info">
                            <i class="bi bi-eye-fill me-2 text-info"></i> Voir comme Membre
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modale de Connexion Admin -->
    <div class="modal fade" id="adminModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success bg-gradient text-white px-4 py-3">
                    <h5 class="modal-title fw-bold"><i class="bi bi-key-fill me-2"></i> Connexion Trésorier</h5>
                    <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="VerifierAdmin" asp-route-codePartage="@Model.CodePartage" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="motDePasse" class="form-label fw-bold text-secondary">🔑 Mot de Passe Admin</label>
                            <input type="password" name="motDePasse" id="motDePasse" class="form-control form-control-lg rounded-3 shadow-sm" placeholder="Entrez votre mot de passe" required>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                @if (ViewData.ModelState["motDePasse"]?.Errors.Any() == true)
                                {
                                    <span class="text-danger small fw-semibold">
                                        <i class="bi bi-exclamation-circle me-1"></i> @ViewData.ModelState["motDePasse"].Errors[0].ErrorMessage
                                    </span>
                                }
                                <a asp-action="ForgotPassword" class="text-decoration-none text-muted small ms-auto">Mot de passe oublié ?</a>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3 border-0">
                        <button type="button" class="btn btn-light px-4 rounded-pill text-secondary fw-semibold" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-success px-4 rounded-pill fw-semibold shadow-sm">Se Connecter</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Styles CSS personnalisés pour l'effet professionnel -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    }
    .btn-hover-effect {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .btn-hover-effect:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var myModal = document.getElementById('adminModal');
        var myInput = document.getElementById('motDePasse');

        // Force le focus sur l'input quand la modal finit de s'afficher
        myModal.addEventListener('shown.bs.modal', function () {
            myInput.focus();
        });

        // AUTO-OUVRIR LA MODAL SI ERREUR
        @if (ViewData.ModelState["motDePasse"]?.Errors.Any() == true)
        {
            <text>
            var modal = new bootstrap.Modal(myModal);
            modal.show();
            </text>
        }
    });
</script>